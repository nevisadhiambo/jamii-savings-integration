<sequence xmlns="http://ws.apache.org/ns/synapse"
          name="JamiiHeaderInject_{{flow}}_{{direction}}">
    <header name="{{ headerName }}"
            value="{{ headerValue }}"
            scope="transport"/>
    {% if flow == "response" %}
    <header name="X-Jamii-API-Version"
            value="AccountBalanceAPI/1.0.0"
            scope="transport"/>
    {% endif %}
</sequence>
